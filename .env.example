# =============================================================================
# FOLIO — example environment (safe to commit, no real secrets)
# =============================================================================
# Two files are loaded at runtime:
#
#   .env         → CLIENT (Expo). Only EXPO_PUBLIC_* values are ever bundled.
#   .env.server  → SERVER (`server/serve.js`). Contains real secrets.
#                  Never imported by Expo. Never bundled.
#
# Copy this file twice:
#   cp .env.example  .env
#   cp .env.example  .env.server
# Then fill the relevant section in each.
# =============================================================================

# -----------------------------------------------------------------------------
# .env (CLIENT) — keep ONLY these in your local .env
# -----------------------------------------------------------------------------
EXPO_PUBLIC_AI_API_URL=http://localhost:3000/api/chat
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-only
# EXPO_PUBLIC_AI_PROXY_TOKEN=optional-shared-secret-with-backend
# EXPO_PUBLIC_ALLOW_DEMO=true

# -----------------------------------------------------------------------------
# .env.server (SERVER) — keep ONLY these in your local .env.server
# -----------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=put_your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# AI_PROVIDER=gemini
# GEMINI_API_KEY=put_your_google_ai_studio_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite

SUPABASE_SERVICE_ROLE_KEY=server-side-only-service-role-key
# AI_PROXY_TOKEN=optional-shared-secret-with-client
# APP_PUBLIC_URL=https://api.your-domain.com
# PORT=3000
# AI_RATE_WINDOW_MS=60000
# AI_RATE_MAX_PER_WINDOW=30
# AI_MAX_BODY_BYTES=65536
