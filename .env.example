# ── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=put_your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional Gemini alternative:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=put_your_google_ai_studio_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite

# ── Supabase ─────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com and paste your credentials here.
# The app gracefully degrades to local-only mode when these are missing.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server-side only

# ── Client API ───────────────────────────────────────────────────────────────
# For Expo Go on a real phone, use your computer LAN IP, not localhost.
# Example: EXPO_PUBLIC_AI_API_URL=http://192.168.1.20:3000/api/chat
EXPO_PUBLIC_AI_API_URL=http://localhost:3000/api/chat

# ── Server ───────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-from-supabase  # for Node server verification

# ── Dev flags ────────────────────────────────────────────────────────────────
# When set to "true", the AI error card exposes an explicit
# "show demo answer" button. Demo answers are always clearly
# labeled as demo and never presented as real AI output.
# Leave commented (or set to anything other than "true") in production.
# EXPO_PUBLIC_ALLOW_DEMO=true
