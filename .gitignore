.vscode/
.idea/
*.sublime-workspace

# local env files
.env
.env.*
!.env.example

# Secrets (defense in depth — never commit any flavour)
.env.server
.env.local
.env.production

# typescript
*.tsbuildinfo
.vercel

# EAS / native artifacts
.eas/
*.aab
*.apk
*.ipa
